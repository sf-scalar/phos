# Copy this file and rename it to '.env' before running training or sync scripts.

# Hugging Face Write Token (Required for pushing model weights, adapters, and GGUF shards)
# Generate a token with 'write' permissions at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hugging_face_write_token_here

# Weights & Biases API Key (Optional — used for tracking loss curves during QLoRA training)
# Retrieve your key at: https://wandb.ai/authorize
WANDB_API_KEY=
